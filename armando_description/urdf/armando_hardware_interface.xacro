<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="armando_hardware_interface">

    <ros2_control name="HardwareInterface_Gazebo" type="system">

      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="j0">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

      <joint name="j1">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

      <joint name="j2">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

      <joint name="j3">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
